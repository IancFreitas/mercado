# Copie para .env.local (NUNCA faça commit de .env.local).
# A "anon/publishable key" do Supabase é pública por design; a segurança vem das políticas RLS.
# NUNCA coloque a service_role key aqui nem em nenhum arquivo do frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Caminho base para GitHub Pages (ex.: /mercado/). Use / para desenvolvimento local.
VITE_BASE=/
